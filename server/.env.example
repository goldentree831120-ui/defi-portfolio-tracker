# Copy to .env (git-ignored). Nothing in this file is sent to the browser.

# Postgres. `npm run dev:local` starts an embedded one on this URL (no install, no Docker).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/tracker

# Read-only RPC. For Sepolia use your Alchemy/Infura URL; the key stays on the server.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# The Staking contract to index, and the block it was deployed in (indexing starts there).
STAKING_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0

# Blocks to wait before indexing a block. 0 on a local Hardhat node; 12 or more on Sepolia.
CONFIRMATIONS=0
POLL_INTERVAL_MS=4000
# Blocks per eth_getLogs call. Halved automatically if the RPC says the range is too large.
BATCH_SIZE=500

HOST=127.0.0.1
PORT=3001
# The front end's origin, for CORS (comma-separated for several).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
