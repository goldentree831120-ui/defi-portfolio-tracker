# Copy to /home/ubuntu/app/.env ON THE SERVER ONLY (it is git-ignored).
# Never commit it, never paste it into a chat or a screenshot.

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Your Alchemy Sepolia URL: https://eth-sepolia.g.alchemy.com/v2/...
RPC_URL=

CHAIN_ID=11155111
STAKING_ADDRESS=0xd6AE22a0adE46C7eDbB92db28F6360089B94f513
START_BLOCK=11962200
CONFIRMATIONS=12

# Poll every 60 s (a few blocks per poll): keeps Alchemy usage far inside its free tier.
POLL_INTERVAL_MS=60000

# Your CloudFront URL once it exists, e.g. https://d1234abcd.cloudfront.net
PUBLIC_ORIGIN=http://localhost:8080
