# Public, non-secret config only. Everything prefixed VITE_ is bundled into the
# JavaScript the browser downloads, so never put an RPC API key or private key here.

# 11155111 = Sepolia, 31337 = local Hardhat node
VITE_CHAIN_ID=11155111
# Staking contract. The token address is read from stakingToken() on-chain.
VITE_STAKING_ADDRESS=0x707AbBCEd16c1872e08ba56d079eacE17960F8D6
