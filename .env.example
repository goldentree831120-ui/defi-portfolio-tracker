# Copy to .env (git-ignored) for `docker compose up` against a real chain.
# Server-side only: none of these reach the browser except CHAIN_ID and STAKING_ADDRESS,
# which are public anyway (they're built into the frontend).

# Postgres password. Letters and digits only (it's embedded in a URL). Generate one:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Your Alchemy/Infura Sepolia URL. Contains your API key: keep it in .env, never in the frontend.
RPC_URL=
CHAIN_ID=11155111

# Your Staking contract and the block it was deployed in (the indexer starts there).
STAKING_ADDRESS=
START_BLOCK=

# Wait this many blocks before indexing a block (reorg safety). 12 is a sensible Sepolia value.
CONFIRMATIONS=12
POLL_INTERVAL_MS=12000

# Where the app is served from (CORS). http://localhost:8080 locally.
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
